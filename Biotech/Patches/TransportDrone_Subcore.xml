<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    这个目录只在启用生物科技时加载。
    次生核心有三级：基础、标准、高级；标准次生核心是中间一级。
    只加建造消耗，拆掉时不额外掉落核心。
  -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="TransportDrone"]/costList</xpath>
    <value>
      <SubcoreRegular>3</SubcoreRegular>
    </value>
  </Operation>
</Patch>
