<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OdysseyTransportShuttleEnhanced</AssemblyName>
    <RootNamespace>OdysseyTransportShuttleEnhanced</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Version>1.0.0</Version>
    <RimWorldPath>E:\SteamLibrary\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>

  <!--
    Net472 目录是 1.6 的构建工程，它自己的 obj 里会生成一份 AssemblyAttributes.cs。
    默认的 Compile 项会把 Source 下所有 .cs 递归收进来，连 Net472\obj 也会算上，
    两份 AssemblyAttributes 撞在一起就是 CS0579。这里把子目录整个排除。
  -->
  <ItemGroup>
    <Compile Remove="Net472\**" />
    <None Remove="Net472\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>E:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
